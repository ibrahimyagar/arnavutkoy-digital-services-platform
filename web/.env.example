VITE_API_BASE_URL=

# Local development: leave empty. Vite proxies /api → http://localhost:8080
# so phones on the LAN can use http://<PC-IP>:5173 without mixed-origin API calls.
#
# Do NOT set this to http://localhost:8080 while testing on a phone — the phone
# would request its own localhost, not the API on your computer.
#
# Cloudflare Pages production (HTTPS, no trailing slash):
# VITE_API_BASE_URL=https://arnavutkoy-digital-services-platform.onrender.com
#
# Production build fails if this is empty or points to localhost.
