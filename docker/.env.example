# Bu dosyayı kopyalayıp `.env` olarak kaydedin (`cp .env.example .env`),
# ardından değerleri kendi ortamınıza göre değiştirin.
# `.env` git'e eklenmez (bkz. .gitignore).

# --- PostgreSQL ---
POSTGRES_DB=arnavutkoy
POSTGRES_USER=arnavutkoy
POSTGRES_PASSWORD=ChangeMe_LocalOnly_Postgres!
POSTGRES_PORT=5432

# --- API ---
API_PORT=8080
ASPNETCORE_ENVIRONMENT=Development
DATABASE_SEED_ON_STARTUP=true
SWAGGER_ENABLED=true

# JWT imzalama anahtarı en az 32 karakter olmalıdır (fail-fast doğrulama).
# Üretimde mutlaka güçlü, rastgele bir değer kullanın; bu örnek yalnızca lokal demoda geçerlidir.
JWT_SIGNING_KEY=docker-compose-dev-only-signing-key-min-32-chars
JWT_ISSUER=ArnavutkoyBelediyesi.Api
JWT_AUDIENCE=ArnavutkoyBelediyesi.Client
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7

# Opsiyonel: Seq sunucusu (bos birakilirsa yalnizca konsol/stdout loglanir)
# SERILOG__SEQ__SERVERURL=http://localhost:5341
